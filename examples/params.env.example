# params.env — OPNsense VPN VM deployment parameters
# Copy to params.env and fill in your values, then: source params.env && ./deploy.sh

# Required
SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"

# Optional (defaults shown)
RESOURCE_GROUP="rg-opnsense-vpn"
LOCATION="westeurope"
VNET_NAME="vnet-opnsense"
VNET_CIDR="10.200.0.0/16"
SUBNET_WAN_CIDR="10.200.0.0/24"
SUBNET_LAN_CIDR="10.200.1.0/24"
VM_NAME="vm-opnsense-01"
VM_SIZE="Standard_B2ts_v2"      # B2ms for heavier loads
ADMIN_USER="azureadmin"
ADMIN_PASSWORD=""              # prompted if empty
OPNSENSE_VERSION="26.1"
HOSTNAME_LABEL="opn-vpn-01"

# Script hosting URL (change to your fork/repo)
CONFIG_BASE_URL="https://raw.githubusercontent.com/sragamir/AzureVPNGWtoOPNsense/main/scripts"
