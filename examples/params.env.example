# params.env — OPNsense VPN VM deployment parameters
# Copy to params.env and fill in your values, then:
#   PowerShell: .\deploy.ps1
#   Bash:       source params.env && ./deploy.sh

# Required
SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"

# Optional (defaults shown)
RESOURCE_GROUP="rg-opnsense-vpn"
LOCATION="westeurope"
VM_NAME="vm-opnsense-01"
VM_SIZE="Standard_B2ts_v2"
ADMIN_USER="azureadmin"
ADMIN_PASSWORD=""
OPNSENSE_VERSION="26.1"
HOSTNAME_LABEL="opn-vpn-01"

# VNet settings — for new VNet creation
VNET_NAME="vnet-opnsense"
VNET_CIDR="10.200.0.0/16"
SUBNET_WAN_NAME="snet-wan"
SUBNET_WAN_CIDR="10.200.0.0/24"
SUBNET_LAN_NAME="snet-lan"
SUBNET_LAN_CIDR="10.200.1.0/24"

# Set to "true" to deploy into an existing VNet (skips VNet/subnet creation)
# Make sure VNET_NAME, SUBNET_WAN_NAME, and SUBNET_LAN_NAME match existing resources
USE_EXISTING_VNET="false"

# Script hosting URL (change to your fork/repo)
CONFIG_BASE_URL="https://raw.githubusercontent.com/sragamir/AzureVPNGWtoOPNsense/main/scripts"
